# Default mode. This lets the app run without a paid model API.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# DeepSeek example. Copy this file to backend/.env, then uncomment and fill in:
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=your_deepseek_api_key_here
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-v4-flash

# DeepSeek Pro reasoning example:
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=your_deepseek_api_key_here
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-v4-pro
# LLM_THINKING_TYPE=enabled
# LLM_REASONING_EFFORT=high

# Local RAG retrieval settings.
# The first ingestion with Chroma downloads the embedding and reranker models.
RAG_VECTOR_BACKEND=chroma
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RAG_USE_RERANKER=true
RAG_RETRIEVAL_K=30
